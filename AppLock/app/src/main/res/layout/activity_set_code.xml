<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/textFirstTimeNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/setcode_first_time"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutCurrentCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxBackgroundColor="@color/surface"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeColor="@color/accent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editCurrentCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setcode_current_hint"
            android:inputType="numberPassword"
            android:textColor="@color/text_primary" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="@color/surface"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeColor="@color/accent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editNewCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setcode_new_hint"
            android:inputType="numberPassword"
            android:textColor="@color/text_primary" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="@color/surface"
        app:hintTextColor="@color/text_secondary"
        app:boxStrokeColor="@color/accent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editConfirmCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setcode_confirm_hint"
            android:inputType="numberPassword"
            android:textColor="@color/text_primary" />

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/textSetCodeError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_danger"
        android:textSize="13sp"
        android:layout_marginTop="12dp"
        android:visibility="invisible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/setcode_save"
        app:backgroundTint="@color/accent" />

</LinearLayout>
